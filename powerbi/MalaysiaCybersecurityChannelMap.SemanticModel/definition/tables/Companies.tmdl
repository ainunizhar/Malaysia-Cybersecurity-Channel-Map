	partition Companies = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "malaysia_companies.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"Company ID", "Founded Year", "Employee Range Order", "Revenue Range Order", "Services Offered", "Gap Count", "Gap Band Order", "Funding Rounds", "Partner Evidence Items", "Direct Evidence Items", "Decision Makers Found"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Company ID", Int64.Type}, {"Company", type text}, {"Website", type text}, {"HQ Country", type text}, {"HQ Location", type text}, {"Industries", type text}, {"Description", type text}, {"Founded Year", Int64.Type}, {"Employee Range", type text}, {"Employee Range Order", Int64.Type}, {"Estimated Revenue Range", type text}, {"Revenue Range Order", Int64.Type}, {"Operating Status", type text}, {"Segment", type text}, {"Segment Detail", type text}, {"GTM Shortlist", type text}, {"Primary Segment", type text}, {"Hybrid Flag", type text}, {"Cyber Practice", type text}, {"Market Focus", type text}, {"Geographic Focus", type text}, {"MSC Status", type text}, {"Segment Confidence", type text}, {"Segment Evidence URL", type text}, {"Segment Evidence Note", type text}, {"Services Research Status", type text}, {"DF", type text}, {"IR", type text}, {"DFIR", type text}, {"MDR/EDR", type text}, {"XDR", type text}, {"SIEM", type text}, {"VA/Pen Test", type text}, {"SOC-as-a-Service", type text}, {"Compromise Assessment", type text}, {"Services Offered", Int64.Type}, {"Gap Count", Int64.Type}, {"Gap Band", type text}, {"Gap Band Order", Int64.Type}, {"Gap Services", type text}, {"Conflict Flag", type text}, {"Segmentation Override", type text}, {"Services Confidence", type text}, {"Services Evidence URL", type text}, {"Services Evidence Note", type text}, {"SIEM Finding", type text}, {"SIEM Platforms", type text}, {"Platform Vendors", type text}, {"Platform Category", type text}, {"Relationship Type", type text}, {"Signal Source", type text}, {"Multiple Platforms", type text}, {"SIEM Cross-check", type text}, {"Evidence Layers", type text}, {"SIEM Confidence", type text}, {"SIEM Evidence URL", type text}, {"SIEM Evidence Note", type text}, {"Ownership Type", type text}, {"Funding Status", type text}, {"Funding Rounds", Int64.Type}, {"Total Funding Raised", type text}, {"Latest Round Type", type text}, {"Latest Round Amount", type text}, {"Latest Round Date", type text}, {"Listed", type text}, {"Listing Detail", type text}, {"GLC", type text}, {"Disclosed Revenue Range", type text}, {"Financial Health", type text}, {"Funding Confidence", type text}, {"Funding Evidence URL", type text}, {"GTM Model", type text}, {"GTM Confidence", type text}, {"GTM Basis", type text}, {"Partner Evidence Items", Int64.Type}, {"Direct Evidence Items", Int64.Type}, {"Decision Makers Found", Int64.Type}}, "en-US"),

				    WithDM = Table.AddColumn(Typed, "Decision Maker Found", each if [Decision Makers Found] = null or [Decision Makers Found] = 0 then "No" else "Yes", type text)
				in
