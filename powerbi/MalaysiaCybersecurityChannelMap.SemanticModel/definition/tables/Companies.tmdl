table Companies
	lineageTag: f2784d8a-7af8-5dba-b61e-cf73cfa92163

	measure Firms = COUNTROWS ( Companies )
		formatString: #,0
		lineageTag: 5e8d98a4-9681-516f-8c2e-909b6a861b2c

	measure 'Cyber Practice Firms' = CALCULATE ( [Firms], Companies[Cyber Practice] = "Yes" )
		formatString: #,0
		lineageTag: 5f5eda93-3ffa-5e5a-bbfe-1983c523a801

	measure 'Cyber Practice (Yes or Partial) %' = DIVIDE ( CALCULATE ( [Firms], Companies[Cyber Practice] IN { "Yes", "Partial" } ), [Firms] )
		formatString: 0%
		lineageTag: ac5b19ec-9cb1-5cb8-b1c4-523657e2ee08

	measure 'GTM Shortlist Firms' = CALCULATE ( [Firms], Companies[GTM Shortlist] = "Yes" )
		formatString: #,0
		lineageTag: c89d7ae6-ea00-5da4-8116-473c7f5f8947

	measure 'Avg Missing Services' = AVERAGE ( Companies[Gap Count] )
		formatString: 0.0
		lineageTag: 2ee8c513-55ee-5f82-a8ed-f3cc200ddbfd

	measure 'Narrow Portfolio Firms' = CALCULATE ( [Firms], Companies[Gap Band Order] = 3 )
		formatString: #,0
		lineageTag: 4d2fd86f-a4f1-54c5-bb05-88b643086d40

	measure 'Services Not Verified' = CALCULATE ( [Firms], Companies[Gap Band] = "Not verified" )
		formatString: #,0
		lineageTag: 7e9926ad-d9f8-5834-a25e-c09056d23dbd

	measure 'SIEM Confirmed' = CALCULATE ( [Firms], Companies[SIEM Finding] = "Confirmed" )
		formatString: #,0
		lineageTag: c288f6c3-c3b6-50a0-86ad-f8bc70154165

	measure 'SIEM None Identified' = CALCULATE ( [Firms], Companies[SIEM Finding] = "None identified" )
		formatString: #,0
		lineageTag: 425b8130-fc23-5a71-a0a1-787e251d6f08

	measure 'SIEM Unverified' = CALCULATE ( [Firms], Companies[SIEM Finding] = "Unverified" )
		formatString: #,0
		lineageTag: 9e53cd1b-8692-5cf9-a05d-84824b3092a8

	measure 'Multiple SIEM Platforms' = CALCULATE ( [Firms], Companies[Multiple Platforms] = "Yes" )
		formatString: #,0
		lineageTag: 6f713263-5e5f-5dbb-b957-e0a04a705c5c

	measure 'Direct GTM' = CALCULATE ( [Firms], Companies[GTM Model] = "Direct" )
		formatString: #,0
		lineageTag: 62190b95-0278-5f0d-9778-8170a4869b22

	measure 'Partner-led or Hybrid' = CALCULATE ( [Firms], Companies[GTM Model] IN { "Partner-led", "Hybrid" } )
		formatString: #,0
		lineageTag: d6535afa-373a-5390-ac86-f81af32cabb8

	measure 'GTM Unknown' = CALCULATE ( [Firms], Companies[GTM Model] = "Unknown" )
		formatString: #,0
		lineageTag: 01299834-acbc-5e14-885a-7527ac8236aa

	measure 'GTM Evidence Items' = SUM ( Companies[Partner Evidence Items] ) + SUM ( Companies[Direct Evidence Items] )
		formatString: #,0
		lineageTag: 9e4085e3-7456-505b-b2d5-03ade32c2fb4

	measure 'Firms With Funding Rounds' = CALCULATE ( [Firms], Companies[Funding Rounds] > 0 )
		formatString: #,0
		lineageTag: 258190cc-4c61-5c70-83a5-9024b1eae45a

	measure 'Listed Firms' = CALCULATE ( [Firms], Companies[Listed] = "Yes" )
		formatString: #,0
		lineageTag: 8f574d6f-7703-583f-ba2f-2fd3334f1310

	measure 'GLC Firms' = CALCULATE ( [Firms], Companies[GLC] = "Yes" )
		formatString: #,0
		lineageTag: 3b6f3661-a3a5-535e-b621-98383ea9b86a

	measure 'Decision Maker Found %' = DIVIDE ( CALCULATE ( [Firms], Companies[Decision Maker Found] = "Yes" ), [Firms] )
		formatString: 0%
		lineageTag: 9d5f32ed-9be8-50f0-b3dc-76b0d5efcc0f

	measure 'Conflict Flags' = CALCULATE ( [Firms], Companies[Conflict Flag] = "Yes" )
		formatString: #,0
		lineageTag: c4ff425d-d3c5-59bf-a107-db38e0de6d10

	measure 'Segmentation Overrides' = CALCULATE ( [Firms], Companies[Segmentation Override] = "Yes" )
		formatString: #,0
		lineageTag: 0b93bd3e-ad6b-5dfd-999e-1d6e7338d830

	measure 'HQ Countries' = DISTINCTCOUNT ( Companies[HQ Country] )
		formatString: #,0
		lineageTag: 4c216e28-fb7a-51db-94b4-9bbbaeccb316

	measure 'Firm Name' = SELECTEDVALUE ( Companies[Company], "Several firms" )
		lineageTag: f54c5531-4be2-5874-86b5-a1fd4c451481

	measure 'KPI Sub Firms' = "MY HQ " & FORMAT ( CALCULATE ( [Firms], KEEPFILTERS ( Companies[HQ Country] = "Malaysia" ) ) + 0, "#,0" ) & "   ·   SG HQ " & FORMAT ( CALCULATE ( [Firms], KEEPFILTERS ( Companies[HQ Country] = "Singapore" ) ) + 0, "#,0" )
		lineageTag: b4f04295-294f-5ece-a867-d1c98f02f204

	measure 'KPI Sub Cyber' = FORMAT ( [Cyber Practice Firms] + 0, "#,0" ) & " full   ·   " & FORMAT ( CALCULATE ( [Firms], Companies[Cyber Practice] = "Partial" ) + 0, "#,0" ) & " partial practice"
		lineageTag: 1fc8536c-f0da-5488-90cc-5b8f7470919d

	measure 'KPI Sub Shortlist' = FORMAT ( DIVIDE ( [GTM Shortlist Firms], [Firms] ), "0%" ) & " of firms researched"
		lineageTag: 969f606b-a312-5c61-85a4-9db01a9b015c

	measure 'KPI Sub SIEM' = FORMAT ( [Multiple SIEM Platforms] + 0, "#,0" ) & " run more than one platform"
		lineageTag: 3f567f6c-d964-580f-b2ab-63381a2792ed

	measure 'KPI Sub Narrow' = "missing 7 to 9 of the 9 services"
		lineageTag: 819bc80f-f0b4-5f61-9528-a90702ef9754

