model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "Companies", "CompanyServices", "ResearchConfidence", "SiemPlatforms", "FundingRounds"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Companies
ref table CompanyServices
ref table ResearchConfidence
ref table SiemPlatforms
ref table FundingRounds
