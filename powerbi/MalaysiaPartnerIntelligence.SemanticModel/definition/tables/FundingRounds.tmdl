table FundingRounds
	lineageTag: 686682f7-9043-556b-a2ef-7874bcc633ec

	measure 'Rounds Recorded' = COUNTROWS ( FundingRounds )
		formatString: #,0
		lineageTag: e4ceece0-ea67-55a7-9a25-b135928aefb3

	measure 'Firms In Round List' = DISTINCTCOUNT ( FundingRounds[Company ID] )
		formatString: #,0
		lineageTag: cef8b92d-be29-5a25-a41e-d6f46141400c

	measure 'Government-Funded Rounds' = CALCULATE ( [Rounds Recorded], FundingRounds[Government Funded] = "Yes" )
		formatString: #,0
		lineageTag: ed8dc667-3080-56ff-be97-9c19b7e1a83d

	column 'Company ID'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 05fe56c3-ad71-575f-ab83-e55a02271fd6
		summarizeBy: none
		sourceColumn: Company ID

	column Company
		dataType: string
		lineageTag: a0ff0fae-2a9e-542b-bb79-ee1b34c18645
		summarizeBy: none
		sourceColumn: Company

	column 'Round Number'
		dataType: int64
		formatString: 0
		lineageTag: c4dcce2e-ab7d-59c1-a718-329a01dbaea9
		summarizeBy: none
		sourceColumn: Round Number

	column 'Round Type'
		dataType: string
		lineageTag: 22303420-b404-5cbb-b655-b597b622c9a8
		summarizeBy: none
		sourceColumn: Round Type

	column Amount
		dataType: string
		lineageTag: ddb9f98f-2238-5b6b-84dd-1705971f59f5
		summarizeBy: none
		sourceColumn: Amount

	column Date
		dataType: string
		lineageTag: 4934b4ba-7786-57b8-959b-177941f5ec91
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 74b71a13-6882-5e84-aa4f-fd7a81e1f6fc
		summarizeBy: none
		sourceColumn: Year

	column 'Government Funded'
		dataType: string
		lineageTag: c9b030ee-cf9b-534f-894d-864a5d3779e3
		summarizeBy: none
		sourceColumn: Government Funded

	column Notes
		dataType: string
		lineageTag: 555c2f63-fefd-5db6-8dd0-03a99a83f2a1
		summarizeBy: none
		sourceColumn: Notes

	column 'Source URL'
		dataType: string
		lineageTag: 8cf6daf8-f5b1-55dd-be73-e314a9b464db
		summarizeBy: none
		sourceColumn: Source URL

	partition FundingRounds = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "malaysia_funding_rounds.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"Company ID", "Round Number", "Year"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Company ID", Int64.Type}, {"Company", type text}, {"Round Number", Int64.Type}, {"Round Type", type text}, {"Amount", type text}, {"Date", type text}, {"Year", Int64.Type}, {"Government Funded", type text}, {"Notes", type text}, {"Source URL", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
